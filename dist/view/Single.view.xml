<mvc:View xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:semantic="sap.f.semantic" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:chart="sap.suite.ui.microchart" xmlns:ff="sap.f" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core"
	controllerName="de.axelspringer.sd.advertising.Angebots_Liste.controller.Single">
	<semantic:SemanticPage id="singlePage" preserveHeaderStateOnScroll="true" toggleHeaderOnTitleClick="true" showFooter="false">
		<semantic:titleHeading>
			<l:HorizontalLayout allowWrapping="false">
				<!--titleHeader: Icon Marke-->
				<l:VerticalLayout class="sapUiSmalMarginStart">
					<FlexBox alignItems="Start" class="sapUiSmallMargin">
						<ff:Avatar src="./picture/{ZzMarke}_logo.png" tooltip="{ZzMarkeText}" displaySize="S" displayShape="Square"/>
					</FlexBox>
				</l:VerticalLayout>
				<l:HorizontalLayout class="sapUiSmallMargin" allowWrapping="false">
					<l:VerticalLayout class="sapUiSmalMarginStart">
						<!--titleHeader: Werbeträger Name-->
						<!--<VBox alignItems="Start" class="sapUiSmallMargin">-->
						<VBox>
							<Title text="{WerbtName}"/>
							<!--<Text id="TitleHeaderText1" text="{Posnr}" tooltip="{i18n>SingleTitleHeaderText1_t1} {Vbeln} - {i18n>SingleTitleHeaderText1_t2} {Posnr}"/>-->
						</VBox>
						<!--<VBox alignItems="Start" class="sapUiSmallMargin">-->
						<VBox>
							<!--<Title text="{WerbtName}"/>-->
							<Text id="PosnrHeader" text="{Posnr}"/>
							<!--// only for scripting-->
							<Text id="Vbeln" text="{Vbeln}" visible="false"/>
							<Text id="Posnr" text="{Posnr}" visible="false"/>
							<!--// only for scripting-->
						</VBox>
					</l:VerticalLayout>
				</l:HorizontalLayout>
			</l:HorizontalLayout>
		</semantic:titleHeading>
		<semantic:titleSnappedContent></semantic:titleSnappedContent>
		<semantic:titleExpandedContent></semantic:titleExpandedContent>
		<!--Header Content -->
		<semantic:headerContent>
			<l:HorizontalLayout allowWrapping="true">
				<FlexBox id="FlexBox5" class="sapUiSmallMargin">
					<Text id="TitleHeaderText2"
						text="Werbezeitraum: { path: 'WerbezeitraumVon', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } } - { path: 'WerbezeitraumBis', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } }"
						tooltip="{i18n>SingleTitleHeaderText1_t1} {Vbeln} - {i18n>SingleTitleHeaderText1_t2} {Posnr}"/>
				</FlexBox>
				<l:VerticalLayout width="100%" visible="{path: 'ZzFormatvText', formatter: '.formatter.PrintX'}">
					<FlexBox id="FlexBox1" class="sapUiSmallMargin" justifyContent="SpaceBetween">
						<items>
							<l:VerticalLayout class="sapUiMediumMarginEnd">
								<Label id="labelHeaderPrint" text="{i18n>SingleLabelHeaderPrint}" design="Bold" displayOnly="false" wrapping="false"/>
								<Text text="{WerbtName}" visible="{path: 'MultiWt', formatter: '.formatter.WtMultipleX2'}"/>
								<Link text="{WerbtName}" press="onButtonWtPress" emphasized="true" visible="{path: 'MultiWt', formatter: '.formatter.WtMultipleX1'}"/>
								<Text text="{ZzChanText}"/>
								<l:HorizontalLayout allowWrapping="true">
									<l:VerticalLayout class="sapUiMediumMarginEnd">
										<Text visible="{path: 'MultiFormat', formatter: '.formatter.FormatMultipleX2'}"
											text="{ZzFormatvText} {parts: ['Fformatkz', 'i18n>constEmpty', 'ZzBreite', 'ZzBreiteEinh', 'ZzHoehe','ZzHoeheEinh'], formatter: '.formatter.buidlFormatText'}"
											tooltip="{parts: ['Fformatkz', 'i18n>constT', 'ZzBreite', 'ZzBreiteEinh', 'ZzHoehe','ZzHoeheEinh'], formatter: '.formatter.buidlFormatText'}"/>
										<Link press="onButtonFormatPress" emphasized="true" visible="{path: 'MultiFormat', formatter: '.formatter.FormatMultipleX1'}"
											text="{ZzFormatvText} {parts: ['Fformatkz', 'i18n>constEmpty', 'ZzBreite', 'ZzBreiteEinh', 'ZzHoehe','ZzHoeheEinh'], formatter: '.formatter.buidlFormatText'}"
											tooltip="{parts: ['Fformatkz', 'i18n>constT', 'ZzBreite', 'ZzBreiteEinh', 'ZzHoehe','ZzHoeheEinh'], formatter: '.formatter.buidlFormatText'}"/>
									</l:VerticalLayout>
								</l:HorizontalLayout>
								<l:HorizontalLayout allowWrapping="true">
									<Text id="ZzFarbigkeit" text="{ZzFarbigkeit}"/>
								</l:HorizontalLayout>
							</l:VerticalLayout>
						</items>
					</FlexBox>
				</l:VerticalLayout>
				<l:VerticalLayout width="100%" visible="{path: 'ZzAdspecialartName', formatter: '.formatter.AdSX'}">
					<FlexBox id="FlexBox10" class="sapUiSmallMargin" alignItems="Start" justifyContent="SpaceBetween">
						<items>
							<l:VerticalLayout class="sapUiSmallMarginEnd">
								<Label id="labelHeaderAdS" text="{i18n>SingleLabelHeaderAdS}" design="Bold" displayOnly="false" wrapping="false"/>
								<Text text="{WerbtName}" visible="{path: 'MultiWt', formatter: '.formatter.WtMultipleX2'}"/>
								<Link text="{WerbtName}" press="onButtonWtPress" emphasized="true" visible="{path: 'MultiWt', formatter: '.formatter.WtMultipleX1'}"/>
								<Text text="{ZzAdspecialartName}"/>
								<Text
									text="{ZzAdspecialtypName} - {ZzGewicht} g {parts: ['ZzSeiten'], formatter: '.formatter.showminus'} {parts: ['ZzSeiten'], formatter: '.formatter.showValue'}"/>
								<Text
									text="{path:'ZzMengePost', type:'sap.ui.model.type.Integer', formatOptions:{groupingEnabled: 'true',minFractionDigits: '0',maxFractionDigits: '0' }} St."/>
							</l:VerticalLayout>
						</items>
					</FlexBox>
				</l:VerticalLayout>
				<l:VerticalLayout width="100%">
					<FlexBox id="flexBox3" class="sapUiSmallMargin" alignItems="End" justifyContent="SpaceBetween">
						<items>
							<l:VerticalLayout class="sapUiMediumMarginEnd">
								<l:HorizontalLayout allowWrapping="true">
									<ObjectStatus tooltip="{AppStatusOrig}"
										state="{ parts:[{path: 'Posstatusinfo'}, {path: 'singleView>/pos0'}], formatter: '.formatter.getPositionColor' }"
										icon="{ parts:[{path: 'Posstatusinfo'}, {path: 'singleView>/pos0'}], formatter: '.formatter.getPositionIcon' }"/>
									<Label id="LabelStufe1" text="{i18n>SingleLabelStufe1}" design="Bold"/>
								</l:HorizontalLayout>
								<l:HorizontalLayout allowWrapping="true">
									<ObjectStatus icon="{ path: 'Step01GenName', formatter: '.formatter.approvTxt' }"/>
									<Text id="TextStufe1" text="{ path: 'Step01GenName', formatter: '.formatter.noApprovtxt' }"
										tooltip="{i18n>SingleTextStufe1_t} { path: 'Step01ApprovDate', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } } "/>
								</l:HorizontalLayout>
							</l:VerticalLayout>
							<l:VerticalLayout class="sapUiMediumMarginEnd">
								<l:HorizontalLayout allowWrapping="true">
									<ObjectStatus tooltip="{AppStatusOrig}"
										state="{ parts:[{path: 'Posstatusinfo'}, {path: 'singleView>/pos1'}], formatter: '.formatter.getPositionColor' }"
										icon="{ parts:[{path: 'Posstatusinfo'}, {path: 'singleView>/pos1'}], formatter: '.formatter.getPositionIcon' }"/>
									<Label id="LabelStufe2" text="{i18n>SingleLabelStufe2}" design="Bold"/>
								</l:HorizontalLayout>
								<l:HorizontalLayout allowWrapping="true">
									<ObjectStatus icon="{ path: 'Step02GenName', formatter: '.formatter.approvTxt' }"/>
									<Text id="TextStufe2" text="{ path: 'Step02GenName', formatter: '.formatter.noApprovtxt' }"
										tooltip="{i18n>SingleTextStufe2_t} { path: 'Step02ApprovDate', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } } "/>
								</l:HorizontalLayout>
							</l:VerticalLayout>
						</items>
					</FlexBox>
				</l:VerticalLayout>
			</l:HorizontalLayout>
		</semantic:headerContent>
		<!--Page Content -->
		<semantic:content>
			<l:HorizontalLayout allowWrapping="true">
				<!--Page Content: Approval Comment-->
				<VBox>
					<f:SimpleForm id="LabelComment" layout="ResponsiveGridLayout" editable="false" title="{i18n>SingleLabelComment}" adjustLabelSpan="false"
						labelSpanXL="2" labelSpanL="2" labelSpanM="2" labelSpanS="5">
						<FormattedText id="approvTextP" htmlText="{FreigabeTextPosition}"/>
					</f:SimpleForm>
				</VBox>
				<!--Page Content: Calculation-->
				<Table id="lineItemsList1" width="auto" updateFinished="onListUpdateFinished" noDataText="{i18n>singleLineItemTableNoDataText}"
					busyIndicatorDelay="{singleView>/lineItemTableDelay}">
					<headerToolbar>
						<Toolbar>
							<Title id="headerToolbarTitle" text="Kalkulation"/>
						</Toolbar>
					</headerToolbar>
					<!--Page Content: Calculation Columns-->
					<columns>
						<Column width='auto'>
							<Label id="Label01" text="{i18n>SingleTitle01}" wrapping="false"/>
						</Column>
						<Column hAlign="Right" width='auto'>
							<Label id="Label02" text="{i18n>SingleTitle02}" wrapping="false"/>
						</Column>
						<Column hAlign="Center">
							<Label id="Label04" text="{i18n>SingleTitle03}" wrapping="false"/>
						</Column>
						<Column hAlign="Right">
							<Label id="Label05" text="{i18n>SingleTitle04}" wrapping="false"/>
						</Column>
					</columns>
					<items>
						<!--Page Content: Calculation Columns Payload-->
						<ColumnListItem>
							<cells>
								<ObjectAttribute text="{i18n>SingleColumn01}"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'Brutto'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }" unit="€"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'Frequence'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false, decimals: 0} }"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqBrutto'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
						</ColumnListItem>
						<ColumnListItem>
							<cells allowWrapping="false" witdh="100%">
								<ObjectAttribute text="{i18n>SingleColumn08}"/>
							</cells>
							<cells allowWrapping="false">
								<ObjectNumber
									number="{ parts:[{path:'BruttoZuschlag'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'Frequence'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false, decimals: 0} }"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqBruttoZuschlag'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
						</ColumnListItem>
						<ColumnListItem>
							<cells>
								<ObjectAttribute text="{i18n>SingleColumn02}"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'ZzNaturalPrz'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="%"/>
							</cells>
							<cells>
								<ObjectAttribute text=""/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqNatural'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
						</ColumnListItem>
						<ColumnListItem>
							<cells>
								<ObjectAttribute text="{i18n>SingleColumn03}"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'RabattAbschlussPrz'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="%"/>
							</cells>
							<cells>
								<ObjectAttribute text=""/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqAbschluss'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
						</ColumnListItem>
						<ColumnListItem>
							<cells>
								<ObjectAttribute text="{i18n>SingleColumn04}"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'ZzRabattPrz5'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="%"/>
							</cells>
							<cells>
								<ObjectAttribute text=""/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqRabatt5'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
						</ColumnListItem>
						<ColumnListItem>
							<cells>
								<ObjectAttribute text="{i18n>SingleColumn05}"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'ZzRabattPrz6'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="%"/>
							</cells>
							<cells>
								<ObjectAttribute text=""/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqRabatt6'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
						</ColumnListItem>
						<ColumnListItem>
							<cells >
								<ObjectAttribute text="{i18n>SingleColumn06}"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'NettoI'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }" unit="€"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'Frequence'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false, decimals: 0} }"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqNettoI'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
						</ColumnListItem>
						<ColumnListItem>
							<cells>
								<ObjectAttribute text="{i18n>SingleColumn07}"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'AeProvProz'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="%"/>
							</cells>
							<cells>
								<ObjectAttribute text=""/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqAeprov'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
						</ColumnListItem>
						<ColumnListItem>
							<cells>
								<ObjectAttribute text="{i18n>SingleColumn99}"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'NettoIi'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
								<!--<ObjectAttribute text="EUR"/>-->
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'Frequence'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false, decimals: 0} }"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqNettoIi'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
									unit="€"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</l:HorizontalLayout>
		</semantic:content>
		<!--Semantic ShareMenu Buttons-->
		<!--<semantic:sendEmailAction>
			<semantic:SendEmailAction id="shareEmail" press="onSendEmailPress"/>
		</semantic:sendEmailAction>-->
		<semantic:closeAction>
			<semantic:CloseAction id="closeColumnEnd" press="onCloseSinglePress"/>
		</semantic:closeAction>
