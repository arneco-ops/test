<mvc:View controllerName="de.axelspringer.sd.advertising.Angebots_Liste.controller.Master" xmlns:mvc="sap.ui.core.mvc" xmlns:l="sap.ui.layout" xmlns="sap.m"
	xmlns:core="sap.ui.core" xmlns:tnt="sap.tnt" xmlns:semantic="sap.f.semantic">
	<semantic:SemanticPage id="masterPage" preserveHeaderStateOnScroll="true" toggleHeaderOnTitleClick="true" busy="{masterView>/busy}"
		busyIndicatorDelay="{masterView>/delay}" headerExpanded="true">
		<semantic:titleHeading>
			<Title id="masterPageTitle" text="{masterView>/title}"/>
		</semantic:titleHeading>
		<semantic:headerContent>
			<l:HorizontalLayout>
				<l:VerticalLayout>
					<l:HorizontalLayout visible="{masterView>/DatePickerVisible}">
						<!--<items>-->
						<DatePicker id="DP1" width="11rem" value="{ path: 'masterView>/DP1', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } }"
							displayFormat="medium" change="handleChangeDate" tooltip="Freigabedatum von"/>
						<ToolbarSpacer/>
						<DatePicker id="DP2" width="11rem" value="{ path: 'masterView>/DP2', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } }"
							displayFormat="medium" change="handleChangeDate" tooltip="Freigabedatum bis"/>
						<!--<ToolbarSpacer/>-->
					</l:HorizontalLayout>
					<l:HorizontalLayout visible="{masterView>/MultiComboBoxVisible}">
						<MultiComboBox id="ApprovGrp" width="22rem"
							items="{ path: '/ApprovalGroupCollection', sorter: { path: 'Wt', descending: false, group: true } }" placeholder="{i18n>masterRegions}">
							<core:Item key="{ApprovGr}" text="{Descr}"/>
						</MultiComboBox>
					</l:HorizontalLayout>
					<!-- For client side filtering add this to the items attribute: parameters: {operationMode: 'Client'}}" -->
				</l:VerticalLayout>
				<Button text="" press="onReload" icon="sap-icon://refresh" type="Transparent" tooltip="Refresh"/>
			</l:HorizontalLayout>
		</semantic:headerContent>
		<semantic:titleSnappedContent></semantic:titleSnappedContent>
		<semantic:titleExpandedContent>
			<!--<Text text="Filter 14 Tage"/>-->
		</semantic:titleExpandedContent>
		<semantic:content>
			<List id="list" width="auto" class="sapFDynamicPageAlignContent"
				items="{ path: '/HeaderCollection', sorter: { path: 'Vbeln', descending: false }, groupHeaderFactory: '.createGroupHeader' }"
				busyIndicatorDelay="{masterView>/delay}" noDataText="{masterView>/noDataText}"
				mode="{= ${device>/system/phone} ? 'None' : 'SingleSelectMaster'}" growing="false" growingScrollToLoad="false" updateStarted="onUpdateStarted"
				updateFinished="onUpdateFinished" selectionChange="onSelectionChange">
				
				<infoToolbar>
					<Toolbar active="true" id="filterBar" visible="{masterView>/isFilterBarVisible}" press="onOpenViewSettings">
						<Title id="filterBarLabel" text="{masterView>/filterBarLabel}"/>
					</Toolbar>
				</infoToolbar>
				<headerToolbar></headerToolbar>
				<items>
					
					<ObjectListItem id="masterRow" type="Navigation" press="onSelectionChange" title="{ZzKanamekd}" unread="true"
						number="{ parts:[{path:'ZzBns'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
						intro="{Vbeln} { path: 'Vkgrp', formatter: '.formatter.vkburCentralTeamCopy' }" numberUnit="%">
						<!--icon="sap-icon://person-placeholder">-->
				
						<firstStatus>
							<ObjectStatus text="{StatusText}" state="{ path: 'Status', formatter: '.formatter.status' }" tooltip="{StatusText}"/>
						</firstStatus>
						<secondStatus>
							<ObjectStatus text="{ path: 'ApprovDate', type: 'sap.ui.model.type.Date', formatOptions: { relative: true, relativeScale: 'auto' } }"
								state="None" tooltip="freigegeben am { path: 'ApprovDate', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } }"/>
						</secondStatus>
						<!--<markers>-->
						<!--	<ObjectMarker type="Flagged"/>-->
						<!--</markers>-->
						<attributes>
							<ObjectAttribute text="{KunnrName}" tooltip="{KunnrName} {KunnrName2} {KunnrName3} - {Kunnr}" />
							<ObjectAttribute text="{WerbtName}" tooltip="{WerbtName} {WerbtName2} {WerbtName3} - {WtNr}"/>
							<!--<ObjectAttribute text="{ path: 'Vkgrp', formatter: '.formatter.vkburCentralTeamCopy' }" tooltip="todo"/>-->
							
							
					
							<!--<ObjectIdentifier text="{WerbtName}"/>-->
							<!--<ObjectMarker type="Flagged" additionalInfo="additionalInfo"/>-->
							<!--<ObjectAttribute text="{ path: 'ApprovDate', type: 'sap.ui.model.type.Date', formatOptions: { style: 'medium' } }"/>-->
							<!--<ObjectListItem>-->
							<!--<markers>-->
							<!--<ObjectMarker type="{ path: 'Vkbur', formatter: '.formatter.vkburCentralTeam' }"/>-->
							<!--<ObjectMarker type="Flagged"/>-->
							<!--<ObjectMarker type="Favorite"/>-->
							<!--<ObjectMarker type="Draft"/>-->
							<!--<ObjectMarker type="Locked"/>-->
							<!--<ObjectMarker type="LockedBy"/>-->
							<!--<ObjectMarker type="Unsaved"/>-->
							<!--<ObjectMarker type="UnsavedBy"/>-->
							<!--</markers>-->
							<!--</ObjectListItem>-->
						</attributes>
					</ObjectListItem>
				</items>
			</List>
		</semantic:content>
	</semantic:SemanticPage>
</mvc:View>
<!---->