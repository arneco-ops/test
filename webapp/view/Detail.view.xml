<mvc:View xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:semantic="sap.f.semantic" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:ff="sap.f" xmlns:tnt="sap.tnt" xmlns:chart="sap.suite.ui.microchart" controllerName="de.axelspringer.sd.advertising.Angebots_Liste.controller.Detail">
	<semantic:SemanticPage id="detailPage" preserveHeaderStateOnScroll="true" toggleHeaderOnTitleClick="true" busy="{detailView>/busy}"
		busyIndicatorDelay="{detailView>/delay}" showFooter="{ path: 'Modus', formatter: '.formatter.footerDetail' }">
		<semantic:titleHeading>
			<l:VerticalLayout>
				<l:HorizontalLayout class="sapUiSmallMargin" allowWrapping="false">
					<!--<l:VerticalLayout class="sapUiSmallMarginStart">-->
					<!--	<FlexBox alignItems="Center" class="sapUiSmallMargin">-->
					<!--		<ff:Avatar src="./picture/{ZzMarke}_logo.gif" tooltip="{ZzMarkeText}" displaySize="S"/>-->
					<!--	</FlexBox>-->
					<!--</l:VerticalLayout> -->
					<l:VerticalLayout>
						<Title text="{ZzKanamekd}"/>
						<!--<ObjectStatus class="sapUiSmallMarginBottom" text="{Status}" state="{StatusTyp}"/>-->
						<FlexBox alignItems="Start">
							<items>
								<VBox class="sapUiSmallMarginEnd">
									<ObjectStatus tooltip="{StatusOrig}" state="{ path: 'Status', formatter: '.formatter.status' }"
										icon="{ path: 'Status', formatter: '.formatter.getStatusIcon' }"/>
								</VBox>
								<VBox class="sapUiSmallMarginEnd">
									<Text id="Text03" text="{Vbeln} {i18n>DetailText03_t2} {ErnamLang}"
										tooltip="{i18n>DetailText03_t1} { path: 'Erdat', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } }"/>
								</VBox>
							</items>
						</FlexBox>
						<FlexBox alignItems="Start" justifyContent="Start">
							<items>
								<VBox class="sapUiSmallMarginEnd">
									<Text id="Text02" tooltip="{i18n>DetailText02_t}"
										text="Gültigkeit: { path: 'Angdt', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } } - { path: 'Bnddt', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' } }"/>
								</VBox>
							</items>
						</FlexBox>
					</l:VerticalLayout>
				</l:HorizontalLayout>
			</l:VerticalLayout>
		</semantic:titleHeading>
		<semantic:titleSnappedContent></semantic:titleSnappedContent>
		<semantic:titleExpandedContent></semantic:titleExpandedContent>
		<semantic:headerContent>
			<!--<l:HorizontalLayout class="sapUiSmallMargin" allowWrapping="true">-->
			<l:HorizontalLayout class="sapUiSmallMargin">
				<FlexBox id="FlexBox1">
					<l:VerticalLayout class="sapUiSmallMarginEnd">
						<Label id="labelHeaderPartner" text="{i18n>DetailLabelHeaderPartner}" design="Bold"/>
						<l:HorizontalLayout allowWrapping="false">
							<ObjectStatus id="iconPartner1" state="None" icon="sap-icon://person-placeholder" tooltip="{i18n>DettailIconPartner1_t}"/>
							<Text text="{KunnrName}" tooltip="{KunnrName} {KunnrName2} {KunnrName3} - {Kunnr}"/>
						</l:HorizontalLayout>
						<l:HorizontalLayout allowWrapping="false">
							<ObjectStatus id="iconPartner2" state="None" icon="{ path: 'WerbtName', formatter: '.formatter.partnerIcon' }" 
								tooltip="{i18n>DettailIconPartner2_t}"/>
							<Text text="{WerbtName}" tooltip="{WerbtName} {WerbtName2} {WerbtName3} - {WtNr}"/>
						</l:HorizontalLayout>
					</l:VerticalLayout>
				</FlexBox>
			</l:HorizontalLayout>
			<l:HorizontalLayout class="sapUiSmallMargin">
				<FlexBox id="FlexBox2">
					<l:HorizontalLayout>
						<l:VerticalLayout class="sapUiSmallMarginEnd">
							<Label id="labelHeaderCalc2" text="{i18n>DetailLabelHeaderCalc1}" design="Bold"/>
							<HBox>
								<l:HorizontalLayout allowWrapping="true">
									<l:VerticalLayout class="sapUiSmallMarginEnd">
										<Text text="{i18n>DetailLabelHeaderCalc2}"/>
										<ObjectNumber
											number="{ parts:[{path:'ZzBrutto'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}"
											unit="€"/>
									</l:VerticalLayout>
								</l:HorizontalLayout>
								<l:HorizontalLayout allowWrapping="true">
									<l:VerticalLayout class="sapUiSmallMarginEnd">
										<Text text="{i18n>DetailLabelHeaderCalc3}"/>
										<ObjectNumber
											number="{ parts:[{path:'ZzNettoI'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}"
											unit="€"/>
									</l:VerticalLayout>
								</l:HorizontalLayout>
								<l:HorizontalLayout allowWrapping="true">
									<l:VerticalLayout class="sapUiSmallMarginEnd">
										<Text text="{i18n>DetailLabelHeaderCalc4}"/>
										<ObjectNumber
											number="{ parts:[{path:'ZzNettoIi'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}"
											unit="€"/>
									</l:VerticalLayout>
								</l:HorizontalLayout>
							</HBox>
						</l:VerticalLayout>
					</l:HorizontalLayout>
				</FlexBox>
			</l:HorizontalLayout>
			<l:HorizontalLayout class="sapUiSmallMargin">
				<FlexBox id="FlexBox4">
					<l:VerticalLayout class="sapUiSmallMarginEnd">
						<Label id="labelHeaderBNS1" text="{i18n>DetailLabelHeaderBNS1}" design="Bold"/>
						<l:HorizontalLayout allowWrapping="false">
							<Text id="labelHeaderBNS2" text="{i18n>DetailLabelHeaderBNS2}" tooltip="{Bns}"/>
						</l:HorizontalLayout>
						<l:HorizontalLayout allowWrapping="false">
							<ObjectNumber
								number="{ parts:[{path:'ZzBns'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}" unit="%"/>
						</l:HorizontalLayout>
					</l:VerticalLayout>
				</FlexBox>
				<FlexBox id="FlexBox3" width="4rem" renderType="Bare" alignContent="Start">
					<chart:RadialMicroChart id="RadialMicroChart1"
						tooltip="{i18n>DetailRadialMicroChart1} {path:'ZzBns', type:'sap.ui.model.type.Integer', formatOptions:{maxIntegerDigits: '3',minFractionDigits: '2',maxFractionDigits: '2' }} %"
						percentage="{ZzBnsHeaderChart}" valueColor="{ path: 'ZzBns', formatter: '.formatter.getBnsColor' }"/>
				</FlexBox>
			</l:HorizontalLayout>
		</semantic:headerContent>
		<semantic:content>
			<l:HorizontalLayout allowWrapping="true">
				<!--<IconTabBar id="idIconTabBarFiori2" upperCase="false" expanded="{device>/isNoPhone}" class="sapUiResponsiveContentPadding">-->
				<!--headerMode="Inline"-->
				<IconTabBar id="idIconTabBarFiori2" upperCase="false" headerBackgroundDesign="Transparent" backgroundDesign="Transparent"
					expanded="{device>/isNoPhone}"  >
					<items>
						<IconTabFilter icon="sap-icon://activity-items" >
							<VBox>
								<f:SimpleForm id="LabelComment" layout="ResponsiveGridLayout" editable="false" title="{i18n>DetailLabelComment}" adjustLabelSpan="false"
									labelSpanXL="2" labelSpanL="2" labelSpanM="2" labelSpanS="5">
									<FormattedText id="approvTextHeader" htmlText="{FreigabeTextHeader}"/>
								</f:SimpleForm>
							</VBox>
						</IconTabFilter>
						<IconTabFilter count="{detailView>/countattach}" icon="sap-icon://attachment">
							<UploadCollection id="UploadCollection2" items="{Header2Attachment}" uploadEnabled="false" uploadButtonInvisible="true">
								<items>
									<UploadCollectionItem documentId="{DocumentId}" fileName="{FileName}" mimeType="{MimeType}" visibleEdit="false" visibleDelete="false"
										thumbnailUrl="{ path: 'MimeType', formatter: '.formatter.getFileType' }" press="onShowAttachment">
										<attributes>
											<ObjectAttribute title="Angelegt von" text="{CreatorName}" active="false"/>
											<ObjectAttribute title="{ path: 'CreatedOn', type: 'sap.ui.model.type.Date', formatOptions: { style: 'long' }}" active="false"/>
											<ObjectAttribute title="Datei Größe" text="{ path: 'FileSize', formatter: '.formatter.formatAttribute' }" active="false"/>
											<!--<ObjectAttribute title="Datei Größe" text="{ path: 'FileSize', type: 'sap.ui.model.type.FileSize', formatOptions: {minIntegerDigits: 3, binaryFilesize: false, maxFractionDigits: 1, maxIntegerDigits: 3 } } active="false" />-->
											<!--<ObjectAttribute text="{ path: 'FileSize', type: 'sap.ui.model.type.FileSize', formatOptions:{ minIntegerDigits: '5' }" />	-->
											<!--<ObjectAttribute title="{ path: 'FileSize', type: 'sap.ui.model.type.FileSize' }" active="false"/>-->
										</attributes>
									</UploadCollectionItem>
								</items>
							</UploadCollection>
						</IconTabFilter>
					</items>
				</IconTabBar>
				<Table id="lineItemsList" width="auto" items="{Header2List}" updateFinished="onListUpdateFinished" selectionChange="onSelectionChange"
					noDataText="{i18n>detailLineItemTableNoDataText}" busyIndicatorDelay="{detailView>/lineItemTableDelay}"
					mode="{ path: 'Modus', formatter: '.formatter.selectMode' }">
					<!--items="{ path: 'Header2List', parameters: {batchgroupId: 'updateStat', changeSetId: 'myChangeSet' }}" -->
					<headerToolbar>
						<Toolbar>
							<Title id="lineItemsTitle" text="{detailView>/lineItemListTitle}"/>
						</Toolbar>
					</headerToolbar>
					<columns headerTextWrapping="false">
						<Column width="4rem">
							<Label id="Label01" text="{i18n>ListColumn01}" wrapping="false" tooltip="{i18n>ListColumn01_t}"/>
						</Column>
						<Column hAlign="Center" width="25px">
							<Label id="Label02" text="{i18n>ListColumn02}" wrapping="false" tooltip="{i18n>ListColumn02_t}"/>
						</Column>
						<Column hAlign="Center" width="25px">
							<Label id="Label10" text="{i18n>ListColumn10}" wrapping="false" tooltip="{i18n>ListColumn10_t}"/>
						</Column>
						<Column width="23%">
							<Label id="Label03" text="{i18n>ListColumn03}" wrapping="false" tooltip="{i18n>ListColumn03_t}"/>
						</Column>
						<Column hAlign="Center" width="2rem">
							<VBox>
								<Label id="Label04" text="{i18n>ListColumn04}" wrapping="false" tooltip="{i18n>ListColumn04_t}"/>
							</VBox>
						</Column>
						<Column hAlign="Center" width="auto">
							<VBox>
								<Label id="Label08" text="{i18n>ListColumn08}" wrapping="false" tooltip="{i18n>ListColumn08_t}"/>
							</VBox>
						</Column>
						<Column hAlign="Right" width='auto'>
							<Label id="Label05" text="{i18n>ListColumn05}" wrapping="false" tooltip="{i18n>ListColumn05_t}"/>
						</Column>
						<Column hAlign="Right" width='auto'>
							<Label id="Label06" text="{i18n>ListColumn06}" wrapping="false" tooltip="{i18n>ListColumn06_t}"/>
						</Column>
						<Column hAlign="Right" width='auto'>
							<Label id="Label07" text="{i18n>ListColumn07}" wrapping="false" tooltip="{i18n>ListColumn07_t}"/>
						</Column>
						<Column hAlign="Center" width="5rem">
							<Label id="Label99" text="{i18n>ListColumn99}" wrapping="false" tooltip="{i18n>ListColumn99_t}"/>
						</Column>
						<!--<Column minScreenWidth="Tablet" demandPopin="true" hAlign="End">
						<Text text="{i18n>ListColumn99}"/>
						</Column>-->
					</columns>
					<items>
						<ColumnListItem type="Navigation" press="toSingle">
							<cells>
								<ObjectAttribute text="{Posnr}"/>
								<!--<ObjectIdentifier text="{Posnr}" title="{Posnr}"/>-->
							</cells>
							<cells>
								<ObjectStatus tooltip="{AppStatusOrig}"
									state="{ parts:[{path: 'Posstatusinfo'}, {path: 'detailView>/pos0'}], formatter: '.formatter.getPositionColor' }"
									icon="{ parts:[{path: 'Posstatusinfo'}, {path: 'detailView>/pos0'}], formatter: '.formatter.getPositionIcon' }"/>
							</cells>
							<cells>
								<ObjectStatus tooltip="{AppStatusOrig}"
									state="{ parts:[{path: 'Posstatusinfo'}, {path: 'detailView>/pos1'}], formatter: '.formatter.getPositionColor' }"
									icon="{ parts:[{path: 'Posstatusinfo'}, {path: 'detailView>/pos1'}], formatter: '.formatter.getPositionIcon' }"/>
							</cells>
							<cells>
								<ObjectAttribute text="{Produkt}" tooltip="{Produkt}"/>
							</cells>
							<cells>
								<ObjectStatus tooltip="{i18n>ListColumn04_t}" icon="{ path: 'StaffelAuswahl', formatter: '.formatter.isManualPricing' }"/>
							</cells>
							<cells>
								<!--<ObjectAttribute text="{ManPreis}" tooltip="{i18n>ListColumn08}"/>-->
								<ObjectStatus tooltip="{i18n>ListColumn08_t}" icon="{ path: 'ManPreis', formatter: '.formatter.isManualPricing' }"/>
							</cells>
							<!--<cells>-->
							<!--	<Image id="iStatusPos" src="./picture/{Posstatusinfo}.png" height="20%" tooltip="{i18n>ListColumn09_t}"/>-->
							<!--<ff:Avatar src="./picture/{Posstatusinfo}.png" tooltip="{i18n>ListColumn09}" displaySize="xs"/>-->
							<!--<ObjectAttribute text="{Posstatusinfo}" />-->
							<!--</cells>-->
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqBrutto'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}"
									unit="€"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqNettoI'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}"
									unit="€"/>
							</cells>
							<cells>
								<ObjectNumber
									number="{ parts:[{path:'FreqNettoIi'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}"
									unit="€"/>
							</cells>
							<cells>
								<!--<FlexBox height="60px" width="60px" alignContent="End" renderType="Bare">-->
								<!--<FlexBox height="60px" width="60px" fitContainer="true" alignContent="Center" renderType="Div">-->
								<!--<layoutData>-->
								<!--	<FlexItemData maxHeight="60px"/>-->
								<!--</layoutData>-->
								<chart:RadialMicroChart id="RadialMicroChart2" class="sapUiSmallMarginEnd"
									tooltip="{i18n>RadialMicroChart2} {path:'Bns', type:'sap.ui.model.type.Integer', formatOptions:{maxIntegerDigits: '3',minFractionDigits: '2',maxFractionDigits: '2' }} %"
									percentage="{BnsChart}" valueColor="{ path: 'Bns', formatter: '.formatter.getBnsColor' }" width="60px" height="60px"/>
								<!--</FlexBox>-->
								<!--"{path:'Bns', type:'sap.ui.model.type.NumberFormat', formatOptions:{groupingEnabled:true,groupingSeparator:',',minFractionDigits:0,maxFractionDigits:0 }}"-->
								<!--  path: "Bns",-->
								<!--type: new sap.ui.model.type.Integer({-->
								<!--    maxIntegerDigits: 3,-->
								<!--    minFractionDigits: 0,-->
								<!--    maxFractionDigits: 0,-->
								<!--    groupingEnabled: true,-->
								<!--    groupingSeparator: ",",-->
								<!--    decimalSeparator: "."-->
								<!--  })-->
								<!--<ObjectNumber number="{ path: 'Bns', formatter: '.formatter.currencyValue' }" unit="%"/>-->
								<!--percentage="{ path: 'Bns', type: 'sap.ui.model.type.Integer'}"-->
								<!--fitContainer="true" alignContent="Center" size="Responsive"   justifyContent="Center"-->
								<!--percentage="{ parts:[{path:'Bns'},{path:'CurrencyCode'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}"-->
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<!--</VBox>-->
			</l:HorizontalLayout>
		</semantic:content>
		<!--Semantic ShareMenu Buttons-->
		<!--<semantic:sendEmailAction>
			<semantic:SendEmailAction id="shareEmail" press="onSendEmailPress"/>
		</semantic:sendEmailAction>-->
		<!-- Semantic Footer Buttons -->
		<semantic:positiveAction>
			<semantic:PositiveAction text="Freigeben" press="onReleaseButtonPress" visible="{ path: 'Modus', formatter: '.formatter.modus' }"/>
		</semantic:positiveAction>
		<semantic:messagesIndicator>
			<semantic:MessagesIndicator press="onMessagesButtonPress"/>
		</semantic:messagesIndicator>
		<semantic:closeAction>
			<semantic:CloseAction id="closeColumn" press="onCloseDetailPress"/>
		</semantic:closeAction>
		<semantic:fullScreenAction>
			<semantic:FullScreenAction id="enterFullScreen"
				visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}" press="toggleFullScreen"/>
		</semantic:fullScreenAction>
		<semantic:exitFullScreenAction>
			<semantic:ExitFullScreenAction id="exitFullScreen"
				visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}" press="toggleFullScreen"/>
		</semantic:exitFullScreenAction>
	</semantic:SemanticPage>
</mvc:View>
